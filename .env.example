# .env.example
# Copy this to '.env'. By default, these point to the Sprint 5 Hosted version.
# To test locally, uncomment the Local Docker URLs and comment out the Sprint 5 URLs.

# --- Sprint 5 (Hosted) ---
BASE_UI_URL=https://practicesoftwaretesting.com
BASE_API_URL=https://api.practicesoftwaretesting.com

# --- Local Docker (Uncomment to use) ---
# BASE_UI_URL=http://localhost:4200
# BASE_API_URL=http://localhost:8091

# --- Test User Credentials ---
ADMIN_EMAIL=admin@practicesoftwaretesting.com
ADMIN_PASSWORD=welcome01
CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
CUSTOMER_PASSWORD=welcome01

# --- Database Configuration ---
# Example for local Docker testing:
DB_CONNECTION_STRING=sqlite:///practicesoftwaretesting.db